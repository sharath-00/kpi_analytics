# ==============================================================================
# Schnell Energy Equipments - Gateway KPI Mail Dashboard Configuration Template
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# Google Sheets Configuration
SPREADSHEET_ID_OR_URL=your_google_sheet_id_or_url
WORKSHEET_NAME=Gateway
SERVICE_ACCOUNT_FILE=service_account.json

# SMTP Email Dispatch Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@schnellenergy.com
SMTP_PASSWORD=your_email_app_password
SENDER_EMAIL=your_email@schnellenergy.com
RECIPIENTS=management@schnellenergy.com,tl@schnellenergy.com
